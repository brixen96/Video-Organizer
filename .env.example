# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Directory Paths (use absolute paths)
VIDEO_DIR=C:\Users\Brix-PC\Downloads\Anissa Kate
THUMBNAIL_DIR=frontend/.thumbnails
PERFORMER_DIR=frontend/.performers
OLD_LOGS_DIR=old_logs
LOG_FILE=app.log

# Database
DB_PATH=./video_organizer.db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# API Keys (NEVER commit these!)
ADULTDATALINK_API_KEY=your-api-key-here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Features
ENABLE_AUTO_SCAN=true
ENABLE_METADATA_FETCH=true

# Performance
VIDEO_CACHE_SIZE=1000
THUMBNAIL_QUALITY=85

# Security
ALLOWED_ORIGINS=http://localhost:8080
